# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/moteal/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/moteal/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# BEGIN Residim (short links: residim.ir/ABCD2345 -> app with link preview)
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
# one public address only: never the hosting account's technical domain or www
RewriteCond %{HTTP_HOST} ^(www\.residim\.ir|residim\.ir\.motealle\.ir)$ [NC]
RewriteRule ^(.*)$ https://residim.ir/$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([A-Za-z2-9]{8})/?$ app/api/share.php?c=$1 [L,QSA]
# آگهی‌های هم‌مسیری (server-rendered for search engines) and the live sitemap
RewriteRule ^ads/?$ app/api/ads.php [L,QSA]
RewriteRule ^ads/([0-9]{3,7})/?$ app/api/ads.php?no=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ app/api/sitemap.php [L]
</IfModule>
<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# v55: HTTPS only from now on (6 months), no plugins, no <base> hijack, no framing by other sites
Header always set Strict-Transport-Security "max-age=15552000"
Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>
# END Residim
